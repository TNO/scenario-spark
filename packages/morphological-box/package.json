{
  "name": "morphological-box",
  "version": "0.5.1",
  "description": "Morphological box (Zwicky box) library and CLI: define key factors, values and (in)consistencies, validate them, and generate consistent scenarios.",
  "keywords": [
    "morphological-analysis",
    "morphological-box",
    "zwicky-box",
    "scenario-planning",
    "scenario-generation",
    "cross-consistency-assessment",
    "llm",
    "cli"
  ],
  "license": "MIT",
  "author": "Erik Vullings <erik.vullings@tno.nl> (http://www.tno.nl)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TNO/scenario-spark.git",
    "directory": "packages/morphological-box"
  },
  "bugs": {
    "url": "https://github.com/TNO/scenario-spark/issues"
  },
  "homepage": "https://github.com/TNO/scenario-spark/tree/main/packages/morphological-box#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "morph-box": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
