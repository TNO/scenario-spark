          "eq-damage.collapse",
          "eq-casualties.limited",
          "eq-capacity.stretched",
          "eq-evacuation.unsafe",
          "eq-rescue.shoring",
          "eq-medical.triage",
          "eq-utilities.water",
          "eq-command.regional",
          "eq-information.avoid"
        ]
      }
